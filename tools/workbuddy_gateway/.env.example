# This file is documentation only. The gateway does not load dotenv files.
# Export selected values in the process environment. Replace placeholders before Live use.

# Shared server settings.
WORKBUDDY_GATEWAY_MODE=demo
WORKBUDDY_GATEWAY_HOST=127.0.0.1
WORKBUDDY_GATEWAY_PORT=8787
WORKBUDDY_GATEWAY_INBOUND_TIMEOUT_SECONDS=5
WORKBUDDY_GATEWAY_MAX_CONNECTIONS=8
WORKBUDDY_GATEWAY_DEVICE_TOKEN=replace_with_a_random_device_token_at_least_16_characters
# In refresh mode this owner-only file can contain a rotated refresh token.
WORKBUDDY_GATEWAY_STATE_PATH=.workbuddy-gateway-state.json
WORKBUDDY_REQUEST_TIMEOUT_SECONDS=15

# Live mode: WorkBuddy API root. HTTPS is required.
WORKBUDDY_BASE_URL=https://www.workbuddy.cn

# Live mode: choose an access token or the complete refresh credential set.
WORKBUDDY_ACCESS_TOKEN=workbuddy_access_token_here
WORKBUDDY_REFRESH_TOKEN=
WORKBUDDY_CLIENT_ID=
WORKBUDDY_CLIENT_SECRET=

# Live mode: OpenAI-compatible speech-to-text endpoint. HTTPS is required.
WORKBUDDY_TRANSCRIPTION_URL=https://provider.example/v1/audio/transcriptions
WORKBUDDY_TRANSCRIPTION_API_KEY=transcription_api_key_here
WORKBUDDY_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
